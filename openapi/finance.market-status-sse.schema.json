{
  "$defs": {
    "InstrumentStatus": {
      "properties": {
        "age_seconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "instrument": {
          "type": "string"
        },
        "last_bar_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "instrument",
        "stale"
      ],
      "type": "object"
    },
    "MarketStatus": {
      "properties": {
        "instruments": {
          "items": {
            "$ref": "#/$defs/InstrumentStatus"
          },
          "type": "array"
        },
        "max_age_seconds": {
          "format": "int32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "ready, starting, recovering, degraded, stopped, expired, missing, unreadable or invalid",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "instruments"
      ],
      "type": "object"
    },
    "MarketStatusData": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "status": {
          "$ref": "#/$defs/MarketStatus"
        }
      },
      "required": [
        "schema_version",
        "status"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "U64Text": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "urn:viramoon:finance:read-stream:1.0:market-status-sse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "data": {
          "$ref": "#/$defs/MarketStatusData"
        },
        "event": {
          "enum": [
            "market_status"
          ],
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/U64Text",
          "description": "Event ID scoped to the delivery stream. Preserve it as text."
        }
      },
      "required": [
        "id",
        "data",
        "event"
      ],
      "type": "object"
    }
  ],
  "unevaluatedProperties": false
}
