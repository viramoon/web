  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BacktestSummary": {
        "type": "object",
        "required": [
          "run_id",
          "strategy",
          "instrument",
          "start",
          "end",
          "total_orders",
          "total_positions",
          "pnl",
          "currency",
          "generated_at"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "instrument": {
            "type": "string"
          },
          "pnl": {
            "type": "string",
            "description": "精确十进制字符串，禁止 JSON number。",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "research": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ResearchReport"
              }
            ]
          },
          "run_id": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "strategy": {
            "type": "string"
          },
          "total_orders": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_positions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "BlockedOrder": {
        "type": "object",
        "required": [
          "signal_session",
          "execution_session",
          "bar_volume",
          "requested_shares",
          "reason"
        ],
        "properties": {
          "bar_volume": {
            "type": "string"
          },
          "execution_session": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          },
          "requested_shares": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "signal_session": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Check": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "Coverage": {
        "type": "string",
        "enum": [
          "full",
          "insufficient"
        ]
      },
      "Dataset": {
        "type": "object",
        "required": [
          "instrument",
          "asset_type",
          "source",
          "source_sha256",
          "data_kind",
          "calendar",
          "first_session",
          "last_session",
          "observations",
          "price_basis",
          "corporate_actions"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "calendar": {
            "type": "string"
          },
          "corporate_actions": {
            "type": "string"
          },
          "data_kind": {
            "type": "string"
          },
          "first_session": {
            "type": "string",
            "format": "date"
          },
          "instrument": {
            "type": "string"
          },
          "last_session": {
            "type": "string",
            "format": "date"
          },
          "observations": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "price_basis": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          }
        }
      },
      "DatasetList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dataset"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExecutionAudit": {
        "type": "object",
        "required": [
          "fills",
          "zero_volume_bars",
          "blocked_zero_volume",
          "blocked_insufficient_volume",
          "blocked_insufficient_cash",
          "recent_fills",
          "recent_blocked"
        ],
        "properties": {
          "blocked_insufficient_cash": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "blocked_insufficient_volume": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "blocked_zero_volume": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "fills": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "recent_blocked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockedOrder"
            }
          },
          "recent_fills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Fill"
            }
          },
          "zero_volume_bars": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Fill": {
        "type": "object",
        "required": [
          "order_id",
          "signal_session",
          "execution_session",
          "executed_at",
          "side",
          "shares",
          "price",
          "commission"
        ],
        "properties": {
          "commission": {
            "type": "string"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "execution_session": {
            "type": "string",
            "format": "date"
          },
          "order_id": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "shares": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "side": {
            "type": "string"
          },
          "signal_session": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "InstrumentStatus": {
        "type": "object",
        "required": [
          "instrument",
          "stale"
        ],
        "properties": {
          "age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "instrument": {
            "type": "string"
          },
          "last_bar_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "request",
          "attempt",
          "created_at"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "request": {
            "$ref": "#/components/schemas/JobRequest"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "summary": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BacktestSummary"
              }
            ]
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "strategy",
          "instrument",
          "start",
          "end",
          "params"
        ],
        "properties": {
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "instrument": {
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/StrategyParams"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "strategy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "timed_out"
        ]
      },
      "MarketStatus": {
        "type": "object",
        "required": [
          "state",
          "instruments"
        ],
        "properties": {
          "instruments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstrumentStatus"
            }
          },
          "max_age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "description": "ready, starting, recovering, degraded, stopped, expired, missing, unreadable or invalid"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Metrics": {
        "type": "object",
        "required": [
          "return_pct",
          "max_drawdown_pct"
        ],
        "properties": {
          "max_drawdown_pct": {
            "type": "string",
            "description": "Positive peak-to-trough percent, exact decimal text."
          },
          "return_pct": {
            "type": "string",
            "description": "Percent, exact decimal text."
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "ResearchReport": {
        "type": "object",
        "required": [
          "dataset",
          "requested_start",
          "requested_end",
          "actual_start",
          "actual_end",
          "observations",
          "warmup_sessions",
          "performance_start",
          "initial_equity",
          "ending_equity",
          "commission_per_order",
          "slippage_bps",
          "risk_free_rate",
          "execution",
          "windows",
          "audit"
        ],
        "properties": {
          "actual_end": {
            "type": "string",
            "format": "date"
          },
          "actual_start": {
            "type": "string",
            "format": "date"
          },
          "audit": {
            "$ref": "#/components/schemas/ExecutionAudit"
          },
          "commission_per_order": {
            "type": "string"
          },
          "dataset": {
            "$ref": "#/components/schemas/Dataset"
          },
          "ending_equity": {
            "type": "string"
          },
          "execution": {
            "type": "string"
          },
          "initial_equity": {
            "type": "string"
          },
          "metrics": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Metrics"
              }
            ]
          },
          "observations": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "performance_start": {
            "type": "string",
            "format": "date"
          },
          "requested_end": {
            "type": "string",
            "format": "date"
          },
          "requested_start": {
            "type": "string",
            "format": "date"
          },
          "risk_free_rate": {
            "type": "string"
          },
          "slippage_bps": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "warmup_sessions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Window"
            }
          }
        }
      },
      "StrategyParams": {
        "type": "object",
        "properties": {
          "fast_period": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "shares": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "slow_period": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Window": {
        "type": "object",
        "required": [
          "coverage"
        ],
        "properties": {
          "actual_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "actual_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "actual_years": {
            "type": [
              "string",
              "null"
            ]
          },
          "calendar_diagnostic": {
            "type": [
              "string",
              "null"
            ],
            "description": "Calendar name, attempted dates, and construction error when unavailable."
          },
          "calendar_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Upper date bound used for the calendar totals."
          },
          "calendar_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "First supported date counted in the calendar totals."
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "coverage_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason reported when the calendar cannot cover the requested dates."
          },
          "expected_sessions": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "label": {
            "type": [
