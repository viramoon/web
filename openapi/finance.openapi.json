{
  "openapi": "3.1.0",
  "info": {
    "title": "finance-api",
    "description": "",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/backtests": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "1..100, default 20",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Exclusive last id in ascending order",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "operationId": "submit",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Stable submission key, 1–128 visible ASCII characters",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/backtests/sample": {
      "get": {
        "tags": [],
        "operationId": "sample",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestSummary"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/backtests/{id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/status": {
      "get": {
        "tags": [
          "market"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Latest market state including unavailable / expired heartbeat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketStatus"
                }
              }
            }
          }
        }
      }
    },
    "/healthz/live": {
      "get": {
        "tags": [],
        "operationId": "live",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/healthz/ready": {
      "get": {
        "tags": [],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BacktestSummary": {
        "type": "object",
        "required": [
          "run_id",
          "strategy",
          "instrument",
          "start",
          "end",
          "total_orders",
          "total_positions",
          "pnl",
          "currency",
          "generated_at"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "instrument": {
            "type": "string"
          },
          "pnl": {
            "type": "string",
            "description": "精确十进制字符串，禁止 JSON number。",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "run_id": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "strategy": {
            "type": "string"
          },
          "total_orders": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_positions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Check": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "InstrumentStatus": {
        "type": "object",
        "required": [
          "instrument",
          "stale"
        ],
        "properties": {
          "age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "instrument": {
            "type": "string"
          },
          "last_bar_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "request",
          "attempt",
          "created_at"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "request": {
            "$ref": "#/components/schemas/JobRequest"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "summary": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BacktestSummary"
              }
            ]
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "strategy",
          "instrument",
          "start",
          "end",
          "params"
        ],
        "properties": {
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "instrument": {
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/StrategyParams"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "strategy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "timed_out"
        ]
      },
      "MarketStatus": {
        "type": "object",
        "required": [
          "state",
          "instruments"
        ],
        "properties": {
          "instruments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstrumentStatus"
            }
          },
          "max_age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "description": "ready, starting, recovering, degraded, stopped, expired, missing, unreadable or invalid"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "StrategyParams": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
