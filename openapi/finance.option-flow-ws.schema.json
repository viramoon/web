{
  "$defs": {
    "BaselineCohort": {
      "properties": {
        "expiry": {
          "format": "date",
          "type": "string"
        },
        "session_segment": {
          "description": "Zero-based 30-minute segment since the start of this liquid session.",
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "underlying_con_id": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "underlying_con_id",
        "expiry",
        "session_segment"
      ],
      "type": "object"
    },
    "BaselineVolumeRate": {
      "description": "Exact contracts-per-millisecond ratio for the typical rate.",
      "properties": {
        "contracts": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "elapsed_millis": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "contracts",
        "elapsed_millis"
      ],
      "type": "object"
    },
    "BudgetStatus": {
      "properties": {
        "account_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "as_of": {
          "format": "date-time",
          "type": "string"
        },
        "confirmed_options": {
          "minimum": 0,
          "type": "integer"
        },
        "discovery_complete": {
          "type": "boolean"
        },
        "hot_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "observed_options": {
          "minimum": 0,
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/SchedulerPhase"
        },
        "reserve_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "rotation_lines": {
          "minimum": 0,
          "type": "integer"
        },
        "stock_lines": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "as_of",
        "account_lines",
        "reserve_lines",
        "stock_lines",
        "hot_lines",
        "rotation_lines",
        "confirmed_options",
        "observed_options",
        "discovery_complete"
      ],
      "type": "object"
    },
    "DecimalText": {
      "pattern": "^(?=-?(?:[0-9][.]?){1,28}(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])",
      "type": "string"
    },
    "FlowObservation": {
      "description": "No trade ID, direction, or participant is implied by these local samples.",
      "properties": {
        "cohort": {
          "$ref": "#/$defs/BaselineCohort"
        },
        "con_id": {
          "format": "int32",
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/U64Text"
        },
        "multiplier": {
          "$ref": "#/$defs/DecimalText"
        },
        "observation": {
          "$ref": "#/$defs/ObservationEvidence"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        }
      },
      "required": [
        "rule_version",
        "status",
        "con_id",
        "generation",
        "cohort",
        "multiplier",
        "observed_at",
        "observation"
      ],
      "type": "object"
    },
    "L1Sample": {
      "properties": {
        "received_at": {
          "format": "date-time",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DecimalText"
        }
      },
      "required": [
        "value",
        "received_at"
      ],
      "type": "object"
    },
    "ObservationEvidence": {
      "oneOf": [
        {
          "properties": {
            "evidence": {
              "$ref": "#/$defs/VolumeIncrease"
            },
            "kind": {
              "enum": [
                "volume_increase"
              ],
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "evidence": {
              "$ref": "#/$defs/QuoteWidening"
            },
            "kind": {
              "enum": [
                "quote_widening"
              ],
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ObservationStatus": {
      "enum": [
        "pending_verification"
      ],
      "type": "string"
    },
    "OptionFlowObservation": {
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetStatus"
        },
        "clue": {
          "$ref": "#/$defs/FlowObservation"
        },
        "coverage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/SubscriptionCoverage"
            }
          ]
        }
      },
      "required": [
        "clue",
        "budget",
        "coverage"
      ],
      "type": "object"
    },
    "OptionFlowObservationData": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/ProductPolicy"
        },
        "observation": {
          "$ref": "#/$defs/OptionFlowObservation"
        },
        "schema_version": {
          "$ref": "#/$defs/OptionFlowVersion"
        },
        "seq": {
          "$ref": "#/$defs/U64Text"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "access",
        "observation"
      ],
      "type": "object"
    },
    "OptionFlowResetData": {
      "additionalProperties": false,
      "properties": {
        "con_id": {
          "format": "int32",
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/OptionFlowResetReason"
        },
        "schema_version": {
          "$ref": "#/$defs/OptionFlowVersion"
        },
        "snapshot": {
          "const": "/api/v1/options/flow/snapshot",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "con_id",
        "reason",
        "snapshot"
      ],
      "type": "object"
    },
    "OptionFlowResetReason": {
      "enum": [
        "cursor_unavailable"
      ],
      "type": "string"
    },
    "OptionFlowState": {
      "enum": [
        "live",
        "disabled"
      ],
      "type": "string"
    },
    "OptionFlowStatusData": {
      "additionalProperties": false,
      "properties": {
        "con_id": {
          "format": "int32",
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "$ref": "#/$defs/OptionFlowVersion"
        },
        "state": {
          "$ref": "#/$defs/OptionFlowState"
        }
      },
      "required": [
        "schema_version",
        "con_id",
        "state"
      ],
      "type": "object"
    },
    "OptionFlowVersion": {
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "ProductPolicy": {
      "additionalProperties": false,
      "properties": {
        "backup_personal_drive": {
          "type": "boolean"
        },
        "derive_non_display": {
          "type": "boolean"
        },
        "display_live": {
          "type": "boolean"
        },
        "license": {
          "$ref": "#/$defs/Token"
        },
        "product": {
          "$ref": "#/$defs/Token"
        },
        "record_local": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": [
        "source",
        "product",
        "license",
        "display_live",
        "record_local",
        "derive_non_display",
        "backup_personal_drive"
      ],
      "type": "object"
    },
    "QuoteWidening": {
      "properties": {
        "ask": {
          "$ref": "#/$defs/L1Sample"
        },
        "ask_size": {
          "$ref": "#/$defs/L1Sample"
        },
        "baseline_samples": {
          "minimum": 0,
          "type": "integer"
        },
        "bid": {
          "$ref": "#/$defs/L1Sample"
        },
        "bid_size": {
          "$ref": "#/$defs/L1Sample"
        },
        "spread": {
          "$ref": "#/$defs/DecimalText"
        },
        "typical_spread": {
          "$ref": "#/$defs/DecimalText"
        }
      },
      "required": [
        "bid",
        "ask",
        "bid_size",
        "ask_size",
        "spread",
        "typical_spread",
        "baseline_samples"
      ],
      "type": "object"
    },
    "SchedulerPhase": {
      "enum": [
        "starting",
        "online",
        "reconnecting",
        "stopped"
      ],
      "type": "string"
    },
    "SubscriptionCoverage": {
      "properties": {
        "access": {
          "$ref": "#/$defs/ProductPolicy"
        },
        "con_id": {
          "format": "int32",
          "type": "integer"
        },
        "covered": {
          "items": {
            "$ref": "#/$defs/SubscriptionCoverageInterval"
          },
          "type": "array"
        },
        "last_observed_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "uncovered": {
          "items": {
            "$ref": "#/$defs/SubscriptionCoverageInterval"
          },
          "type": "array"
        },
        "unknown": {
          "items": {
            "$ref": "#/$defs/SubscriptionCoverageInterval"
          },
          "type": "array"
        }
      },
      "required": [
        "access",
        "con_id",
        "covered",
        "uncovered",
        "unknown"
      ],
      "type": "object"
    },
    "SubscriptionCoverageInterval": {
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Token": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}(?![\\s\\S])",
      "type": "string"
    },
    "U64Text": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
      "type": "string"
    },
    "VolumeComparison": {
      "properties": {
        "baseline_samples": {
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_millis": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "elevated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "typical_rate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BaselineVolumeRate"
            }
          ]
        }
      },
      "required": [
        "elapsed_millis",
        "baseline_samples"
      ],
      "type": "object"
    },
    "VolumeIncrease": {
      "properties": {
        "comparison": {
          "$ref": "#/$defs/VolumeComparison"
        },
        "delta_contracts": {
          "$ref": "#/$defs/DecimalText"
        },
        "earlier_cumulative_volume": {
          "$ref": "#/$defs/L1Sample"
        },
        "estimated_premium": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/DecimalText",
              "description": "Hypothetical amount using one sampled price for the entire volume change."
            }
          ]
        },
        "later_cumulative_volume": {
          "$ref": "#/$defs/L1Sample"
        },
        "sampled_last_price": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/L1Sample"
            }
          ]
        },
        "sampled_last_size": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/L1Sample"
            }
          ]
        }
      },
      "required": [
        "earlier_cumulative_volume",
        "later_cumulative_volume",
        "delta_contracts",
        "comparison"
      ],
      "type": "object"
    }
  },
  "$id": "urn:viramoon:finance:read-stream:1.0:option-flow-ws",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "data": {
          "$ref": "#/$defs/OptionFlowObservationData"
        },
        "event": {
          "enum": [
            "observation"
          ],
          "type": "string"
        },
        "id": {
          "description": "Opaque, contract-scoped resume cursor. Preserve it verbatim.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "data",
        "event"
      ],
      "type": "object"
    },
    {
      "else": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "if": {
        "properties": {
          "data": {
            "properties": {
              "state": {
                "const": "live"
              }
            }
          }
        }
      },
      "properties": {
        "data": {
          "$ref": "#/$defs/OptionFlowStatusData"
        },
        "event": {
          "enum": [
            "status"
          ],
          "type": "string"
        },
        "id": {
          "description": "Position at which live delivery starts or resumes.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "data",
        "event"
      ],
      "then": {
        "required": [
          "id"
        ]
      },
      "type": "object"
    },
    {
      "properties": {
        "data": {
          "$ref": "#/$defs/OptionFlowResetData"
        },
        "event": {
          "enum": [
            "reset_required"
          ],
          "type": "string"
        }
      },
      "required": [
        "data",
        "event"
      ],
      "type": "object"
    }
  ],
  "unevaluatedProperties": false
}
